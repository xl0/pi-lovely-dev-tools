{
	"name": "@xl0/pi-lovely-dev-tools",
	"version": "0.3.6",
	"description": "Pi interactive debugging commands /tool /show-sysprompt /show-context /llm-stats",
	"keywords": [
		"pi-package",
		"dev tools",
		"tools"
	],
	"type": "module",
	"license": "MIT",
	"homepage": "https://github.com/xl0/pi-lovely-dev-tools#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xl0/pi-lovely-dev-tools.git"
	},
	"files": [
		"extensions/",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"scripts": {
		"typecheck": "tsgo --noEmit",
		"check": "bun run typecheck && bun run biome:check",
		"prepublishOnly": "bun run check",
		"release": "bun run scripts/release.ts",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"biome:check": "biome check --error-on-warnings ."
	},
	"dependencies": {},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@earendil-works/pi-ai": "^0.84.0",
		"@earendil-works/pi-coding-agent": "^0.84.0",
		"@earendil-works/pi-tui": "^0.84.0",
		"@typescript/native-preview": "^7.0.0-dev.20260502.1",
		"bun-types": "^1.3.13"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"pi": {
		"extensions": [
			"./extensions"
		],
		"video": "https://raw.githubusercontent.com/xl0/pi-lovely-dev-tools/master/assets/demo.mp4"
	}
}
